# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Browser-restricted Maps JS SDK key (HTTP referrers restricted).
VITE_GOOGLE_MAPS_API_KEY=""

# GOOGLE_MAPS_SERVER_KEY: Optional server-side Routes API key.
GOOGLE_MAPS_SERVER_KEY=""

# RAKSHA_ALLOW_LIVE_DISPATCH: Must remain false until authorized ambulance org integration is validated.
RAKSHA_ALLOW_LIVE_DISPATCH="false"

# Optional external integration adapters (disabled by default)
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
