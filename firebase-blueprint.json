{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public-safe user profile metadata without PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["patient", "caregiver", "frontline_worker", "ambulance_driver", "dispatcher", "hospital_coordinator", "clinician", "facility_admin", "org_admin", "platform_admin", "auditor"] },
        "tenantId": { "type": "string", "enum": ["mh-live", "demo-maharashtra"] },
        "preferredLanguage": { "type": "string", "enum": ["en", "hi", "mr"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "tenantId", "preferredLanguage", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII and optional user-provided clinical metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 },
        "village": { "type": "string", "maxLength": 120 },
        "taluka": { "type": "string", "maxLength": 120 },
        "district": { "type": "string", "maxLength": 120 },
        "bloodGroup": { "type": "string", "maxLength": 12 },
        "allergies": { "type": "string", "maxLength": 500 },
        "medications": { "type": "string", "maxLength": 500 },
        "emergencyContactName": { "type": "string", "maxLength": 120 },
        "emergencyContactPhone": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "updatedAt"]
    },
    "ConsentRecord": {
      "title": "ConsentRecord",
      "description": "Granular revocable DPDP-aligned consent record.",
      "type": "object",
      "properties": {
        "consentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "purpose": { "type": "string", "enum": ["triage_sharing", "referral_sharing", "emergency_gps", "ai_summarization", "family_access"] },
        "granted": { "type": "boolean" },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["consentId", "uid", "purpose", "granted", "version", "updatedAt"]
    },
    "Dependent": {
      "title": "Dependent",
      "description": "Guardian-authorized dependent profile.",
      "type": "object",
      "properties": {
        "dependentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "guardianUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "relationship": { "type": "string", "minLength": 1, "maxLength": 60 },
        "ageYears": { "type": "number" },
        "guardianConfirmed": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["dependentId", "guardianUid", "name", "relationship", "ageYears", "guardianConfirmed", "updatedAt"]
    },
    "HealthRecord": {
      "title": "HealthRecord",
      "description": "User-submitted or facility health summary record.",
      "type": "object",
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "category": { "type": "string", "enum": ["prescription", "lab_report", "discharge_summary", "immunization", "self_note"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "facilityName": { "type": "string", "maxLength": 180 },
        "recordedDate": { "type": "string", "minLength": 4, "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "uid", "title", "category", "summary", "recordedDate", "createdAt"]
    },
    "DsrRequest": {
      "title": "DsrRequest",
      "description": "DPDP Data Subject Export or Deletion Request.",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["export", "deletion"] },
        "status": { "type": "string", "enum": ["submitted", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "uid", "type", "status", "createdAt"]
    },
    "Facility": {
      "title": "Facility",
      "description": "Healthcare facility directory record with explicit provenance and freshness TTL.",
      "type": "object",
      "properties": {
        "facilityId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenantId": { "type": "string", "enum": ["mh-live", "demo-maharashtra"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": { "type": "string", "enum": ["PHC", "RH", "SDH", "DH", "MC", "PRIVATE"] },
        "category": { "type": "string", "enum": ["public", "private", "trust"] },
        "district": { "type": "string", "minLength": 1, "maxLength": 100 },
        "taluka": { "type": "string", "minLength": 1, "maxLength": 100 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "phone": { "type": "string", "maxLength": 32 },
        "hours24x7": { "type": "boolean" },
        "emergencyCapable": { "type": "boolean" },
        "wheelchairAccessible": { "type": "boolean" },
        "data_source": { "type": "string", "minLength": 1, "maxLength": 160 },
        "source_timestamp": { "type": "string", "maxLength": 64 },
        "verification_status": { "type": "string", "enum": ["verified_live", "cached", "unverified", "demo_fixture"] },
        "freshness_ttl": { "type": "number" },
        "last_updated_by": { "type": "string", "maxLength": 128 },
        "icuBedsAvailable": { "type": "number" },
        "generalBedsAvailable": { "type": "number" },
        "oxygenAvailable": { "type": "string", "enum": ["verified_available", "limited", "unavailable", "unknown"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["facilityId", "tenantId", "name", "type", "category", "district", "taluka", "lat", "lng", "data_source", "source_timestamp", "verification_status", "freshness_ttl", "updatedAt"]
    },
    "TriageLog": {
      "title": "TriageLog",
      "description": "Versioned non-diagnostic symptom screening log.",
      "type": "object",
      "properties": {
        "triageId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenantId": { "type": "string", "enum": ["mh-live", "demo-maharashtra"] },
        "ruleVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "urgency": { "type": "string", "enum": ["emergency", "urgent", "routine", "human_review"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "humanReviewRequired": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["triageId", "uid", "tenantId", "ruleVersion", "urgency", "rationale", "humanReviewRequired", "createdAt"]
    },
    "Referral": {
      "title": "Referral",
      "description": "Finite-state-machine healthcare referral record.",
      "type": "object",
      "properties": {
        "referralId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenantId": { "type": "string", "enum": ["mh-live", "demo-maharashtra"] },
        "patientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientDisplayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "originFacilityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "originFacilityName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "destinationFacilityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "destinationFacilityName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "urgency": { "type": "string", "enum": ["emergency", "urgent", "routine"] },
        "status": { "type": "string", "enum": ["draft", "submitted", "under_review", "accepted", "rejected", "transfer_arranged", "in_transit", "arrived", "handed_over", "completed", "cancelled", "expired"] },
        "version": { "type": "number" },
        "idempotencyKey": { "type": "string", "minLength": 4, "maxLength": 128 },
        "reason": { "type": "string", "minLength": 2, "maxLength": 500 },
        "clinicalSummary": { "type": "string", "minLength": 2, "maxLength": 2000 },
        "qrToken": { "type": "string", "maxLength": 128 },
        "qrExpiresAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["referralId", "tenantId", "patientUid", "patientDisplayName", "createdByUid", "originFacilityId", "originFacilityName", "destinationFacilityId", "destinationFacilityName", "urgency", "status", "version", "idempotencyKey", "reason", "clinicalSummary", "createdAt", "updatedAt"]
    },
    "ReferralEvent": {
      "title": "ReferralEvent",
      "description": "Immutable referral transition audit event.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referralId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromStatus": { "type": "string", "maxLength": 40 },
        "toStatus": { "type": "string", "maxLength": 40 },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorRole": { "type": "string", "minLength": 1, "maxLength": 60 },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "referralId", "fromStatus", "toStatus", "actorUid", "actorRole", "createdAt"]
    },
    "EmergencyCase": {
      "title": "EmergencyCase",
      "description": "Emergency assistance request and coordination workflow.",
      "type": "object",
      "properties": {
        "emergencyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenantId": { "type": "string", "enum": ["mh-live", "demo-maharashtra"] },
        "patientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientDisplayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "callbackNumber": { "type": "string", "minLength": 6, "maxLength": 30 },
        "villageOrLandmark": { "type": "string", "minLength": 2, "maxLength": 200 },
        "status": { "type": "string", "enum": ["pending_validation", "acknowledged", "dispatch_proposed", "driver_accepted", "driver_rejected", "en_route_to_patient", "arrived_at_pickup", "patient_onboard", "en_route_to_hospital", "hospital_acknowledged", "arrived_at_hospital", "handed_over", "closed", "cancelled", "no_ambulance_available"] },
        "version": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["emergencyId", "tenantId", "patientUid", "patientDisplayName", "callbackNumber", "villageOrLandmark", "status", "version", "createdAt", "updatedAt"]
    },
    "AmbulanceUnit": {
      "title": "AmbulanceUnit",
      "description": "Registered ambulance asset with consent-gated GPS.",
      "type": "object",
      "properties": {
        "ambulanceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenantId": { "type": "string", "enum": ["mh-live", "demo-maharashtra"] },
        "orgName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "vehicleNumber": { "type": "string", "minLength": 2, "maxLength": 40 },
        "capability": { "type": "string", "enum": ["BLS", "ALS", "NEONATAL", "FIRST_RESPONDER"] },
        "status": { "type": "string", "enum": ["available", "proposed", "assigned", "offline", "maintenance"] },
        "baseDistrict": { "type": "string", "minLength": 1, "maxLength": 100 },
        "isDemo": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ambulanceId", "tenantId", "orgName", "vehicleNumber", "capability", "status", "baseDistrict", "isDemo", "updatedAt"]
    },
    "FollowUpTask": {
      "title": "FollowUpTask",
      "description": "Continuity-of-care follow-up task for patient or ASHA worker.",
      "type": "object",
      "properties": {
        "followUpId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenantId": { "type": "string", "enum": ["mh-live", "demo-maharashtra"] },
        "patientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 180 },
        "dueDate": { "type": "string", "minLength": 4, "maxLength": 32 },
        "status": { "type": "string", "enum": ["pending", "completed", "missed"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followUpId", "tenantId", "patientUid", "title", "dueDate", "status", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only tamper-evident operational audit log.",
      "type": "object",
      "properties": {
        "auditId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenantId": { "type": "string", "enum": ["mh-live", "demo-maharashtra"] },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorRole": { "type": "string", "minLength": 1, "maxLength": 60 },
        "action": { "type": "string", "minLength": 1, "maxLength": 120 },
        "resourceType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "resourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["auditId", "tenantId", "actorUid", "actorRole", "action", "resourceType", "resourceId", "createdAt"]
    },
    "AiSession": {
      "title": "AiSession",
      "description": "Owner-scoped multi-turn RAKSHA AI navigation session.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "modelMode": { "type": "string", "enum": ["balanced", "deep", "fast"] },
        "groundingMode": { "type": "string", "enum": ["none", "search", "maps"] },
        "persona": { "type": "string", "enum": ["navigator", "asha_helper", "emergency_prep"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "uid", "title", "modelMode", "groundingMode", "persona", "createdAt", "updatedAt"]
    },
    "AiMessage": {
      "title": "AiMessage",
      "description": "Immutable turn message inside a user's AI navigation session.",
      "type": "object",
      "properties": {
        "messageId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "model": { "type": "string", "maxLength": 64 },
        "thinkingLevel": { "type": "string", "maxLength": 32 },
        "groundingMode": { "type": "string", "enum": ["none", "search", "maps"] },
        "citations": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["messageId", "sessionId", "uid", "role", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": { "$ref": "#/entities/UserPublic" }, "description": "Public-safe user metadata" },
    "/users/{uid}/private/{docId}": { "schema": { "$ref": "#/entities/UserPrivateInfo" }, "description": "Owner-only isolated PII" },
    "/users/{uid}/consents/{consentId}": { "schema": { "$ref": "#/entities/ConsentRecord" }, "description": "Granular user consents" },
    "/users/{uid}/dependents/{dependentId}": { "schema": { "$ref": "#/entities/Dependent" }, "description": "Guardian-authorized dependents" },
    "/users/{uid}/records/{recordId}": { "schema": { "$ref": "#/entities/HealthRecord" }, "description": "Patient health records" },
    "/users/{uid}/dsr_requests/{requestId}": { "schema": { "$ref": "#/entities/DsrRequest" }, "description": "DPDP export/delete requests" },
    "/users/{uid}/ai_sessions/{sessionId}": { "schema": { "$ref": "#/entities/AiSession" }, "description": "Owner-scoped multi-turn AI sessions" },
    "/users/{uid}/ai_sessions/{sessionId}/messages/{messageId}": { "schema": { "$ref": "#/entities/AiMessage" }, "description": "AI navigation messages inside session" },
    "/facilities/{facilityId}": { "schema": { "$ref": "#/entities/Facility" }, "description": "Healthcare facility directory" },
    "/triage_logs/{triageId}": { "schema": { "$ref": "#/entities/TriageLog" }, "description": "Non-diagnostic triage audit logs" },
    "/referrals/{referralId}": { "schema": { "$ref": "#/entities/Referral" }, "description": "Clinical referral records" },
    "/referrals/{referralId}/events/{eventId}": { "schema": { "$ref": "#/entities/ReferralEvent" }, "description": "Immutable referral FSM events" },
    "/emergencies/{emergencyId}": { "schema": { "$ref": "#/entities/EmergencyCase" }, "description": "Emergency coordination requests" },
    "/ambulances/{ambulanceId}": { "schema": { "$ref": "#/entities/AmbulanceUnit" }, "description": "Ambulance fleet registry" },
    "/follow_ups/{followUpId}": { "schema": { "$ref": "#/entities/FollowUpTask" }, "description": "Care continuity follow-up tasks" },
    "/audit_logs/{auditId}": { "schema": { "$ref": "#/entities/AuditLog" }, "description": "Append-only operational audit logs" }
  }
}
